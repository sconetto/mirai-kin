# Database
DATABASE_URL=postgresql://fin:fin@localhost:5432/fin

# Auth (single user)
AUTH_USERNAME=admin
AUTH_PASSWORD=admin
# Optional: precomputed bcrypt hash. If set, takes precedence over AUTH_PASSWORD.
# AUTH_PASSWORD_HASH=
AUTH_SECRET=change-me-to-a-long-random-string

# API bearer token for external integrations/agents
API_TOKEN=change-me-to-a-random-token

# Base currency (ISO 4217)
BASE_CURRENCY=BRL

# FX provider (ECB reference rates)
FX_SOURCE_URL=https://api.frankfurter.app
