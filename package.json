{
  "name": "mirai-kin",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted personal finance workspace: import, review, report, insight, plan.",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/sconetto/mirai-kin.git"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx src/db/seed.ts",
    "tokens:build": "tsx scripts/build-tokens.ts",
    "api:types": "curl -s http://localhost:3100/api/v1/openapi.json -o /tmp/openapi.json && openapi-typescript /tmp/openapi.json -o src/lib/api-types.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "3.0.75",
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "ai": "7.0.148",
    "archiver": "^8.0.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^18.0.8",
    "drizzle-orm": "^0.45.4",
    "gray-matter": "^4.0.3",
    "jose": "^6.2.13",
    "lucide-react": "^1.60.0",
    "next": "16.4.2",
    "next-intl": "^4.14.9",
    "next-mdx-remote": "^6.0.0",
    "papaparse": "^5.7.0",
    "pg": "^8.23.1",
    "pg-boss": "^12.38.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.10.1",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/archiver": "^8.0.0",
    "@types/node": "^24.19.2",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@10.30.3"
}
